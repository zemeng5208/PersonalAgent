  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "type",
        "serverInstanceId",
        "capabilities",
        "restartRecovery",
        "heartbeatMs"
      ],
      "properties": {
        "protocolVersion": {
          "const": "0.1.0"
        },
        "type": {
          "const": "ready"
        },
        "serverInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "invoke",
              "status",
              "cancel",
              "ephemeral-replay"
            ]
          }
        },
        "restartRecovery": {
          "const": false
        },
        "heartbeatMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "sessionId",
        "requestId",
        "idempotencyKey",
        "payloadDigest",
        "type",
        "deadline",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "const": "0.1.0"
        },

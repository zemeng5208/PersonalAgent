{
  "name": "@personal-agent/contracts",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/protocol.json",
    "./windows-host": {
      "types": "./dist/windows-host.d.ts",
      "import": "./dist/windows-host.js"
    },
    "./windows-host-schema": "./schema/windows-host.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}

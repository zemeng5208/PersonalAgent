# Build context is generated by scripts/image-context.mjs; never the repository root.
FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d
WORKDIR /opt/personal-agent
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps
RUN npm install --global npm@11.12.1 && npm ci --omit=dev --ignore-scripts --no-audit --no-fund
ENV NODE_ENV=production PORT=8080 PA_AGENT_HOST_MODE=agentarts
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD node -e "fetch('http://127.0.0.1:8080/ping').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/agentarts-runtime/src/main.mjs"]

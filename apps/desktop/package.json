{
  "name": "@personal-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node -e \"require('electron/install.js')\"",
    "start": "electron .",
    "dev:fake": "electron . --fake-runtime",
    "typecheck": "node --check electron/main.js && node --check electron/runtime.js && node --check electron/preload.cjs && node --check src/app/renderer.js && node --check src/features/admin/view.js && node --check src/features/orb/orb.js && node --check src/features/conversation/state.js",
    "dev:text-fake": "electron . --fake-model",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/electron-smoke.cjs",
    "test:text-smoke": "node test/text-chat-smoke.cjs"
  },
  "dependencies": {
    "@personal-agent/client": "0.1.0-alpha.1",
    "@personal-agent/runtime": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@personal-agent/testkit": "0.1.0-alpha.1",
    "electron": "44.2.0",
    "playwright": "1.63.0"
  }
}

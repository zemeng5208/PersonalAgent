{
  "name": "@personal-agent/runtime",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./weather": {
      "types": "./dist/weather-runtime.d.ts",
      "import": "./dist/weather-runtime.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    }
